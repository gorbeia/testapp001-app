# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/elkartearen"

# Session Configuration
SESSION_SECRET="your-session-secret-here-change-in-production"

# JWT — society app (login, refresh, httpOnly cookies / Bearer)
# Used to sign and verify access + refresh tokens in server/routes/index.ts and server/routes/middleware.ts.
# Local dev: the placeholder below (or omitting JWT_SECRET) matches the server’s built-in dev default — fine only on localhost.
# Production: set a long random string (e.g. openssl rand -base64 32); never commit real secrets.
JWT_SECRET="dev-only-jwt-secret-do-not-use-in-production"

# Backoffice (superadmin) JWT — separate from society app
BACKOFFICE_JWT_SECRET="dev-only-backoffice-jwt-secret-do-not-use-in-production"

# Environment
NODE_ENV="development"

# Local image uploads (served at /api/images/...). Override in production if needed.
# UPLOADS_DIR="./uploads"

# Application Settings
# macOS: AirPlay Receiver often uses 5000 — use 5001 + matching VITE_API_URL if pnpm dev fails with EADDRINUSE.
PORT="5000"
# Bind address (default 0.0.0.0). Use 127.0.0.1 if listen fails with ENOTSUP in a restricted environment.
# HOST="127.0.0.1"

# Socket.IO Configuration
VITE_API_URL="http://localhost:5000"

# E2E (optional). If unset, Playwright uses VITE_API_URL, else http://localhost:${PORT}
# E2E_BASE_URL="http://localhost:5001"

# Outbound email (optional in dev; use a transactional SMTP provider in production)
# EMAIL_ENABLED=true
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# MAIL_FROM="noreply@example.com"
# Optional default From display name when a message does not set one (jakinarazpenak use the society name)
# MAIL_FROM_NAME="Gure Txokoa"
# Log full email content to server stdout (no SMTP required); use for local/staging validation only
# MAIL_LOG_TO_STDOUT=true

# SEPA Configuration (for production)
SOCIETY_IBAN=""
SOCIETY_NAME=""
CREDITOR_ID=""
